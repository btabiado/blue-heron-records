# Response headers for hosts that read this file (Cloudflare Pages, Netlify).
# GitHub Pages, which currently origins blueheronrecords.com, ignores it.
# frame-ancestors is ignored in a <meta> CSP, so it has to be a real header.
# Copy the rules below into Cloudflare → Rules → Transform Rules →
# Modify Response Header until the host applies this file itself.
# More specific paths override the /* defaults.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Cache-Control: public, max-age=300, must-revalidate

/*.html
  Cache-Control: public, max-age=300, must-revalidate

/images/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=604800

/*.css
  Cache-Control: public, max-age=604800

/*.js
  Cache-Control: public, max-age=604800

/admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/admin/*
  X-Robots-Tag: noindex, nofollow
